# ==============================================================================
# SIJAGO FRONTEND (Next.js App Router + MapLibre GL JS) — ENVIRONMENT VARIABLES
# Salin file ini menjadi `.env.local` (atau `.env`) lalu isi nilainya secara manual.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KONEKSI KE SIJAGO BACKEND API (Express.js)
# ------------------------------------------------------------------------------
# URL publik API Backend (Lokal: http://localhost:4000/v1 | Produksi: https://<sijago-api>.onrender.com/v1)
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/v1"

# URL aplikasi Frontend sendiri (untuk pembuatan tautan berbagi & SEO metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. KONFIGURASI PETA & GEOSPASIAL KOTA BOGOR (MapLibre GL JS + OpenStreetMap)
# ------------------------------------------------------------------------------
# Style Tile Peta Gratis (Default memakai OpenFreeMap / OSM Vector & Raster tiles tanpa API key)
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# Titik Tengah Default Peta (Pusat Kota Bogor — sekitar Kebun Raya Bogor)
NEXT_PUBLIC_DEFAULT_MAP_LAT="-6.5971469"
NEXT_PUBLIC_DEFAULT_MAP_LNG="106.8060388"
NEXT_PUBLIC_DEFAULT_MAP_ZOOM="13"

# ------------------------------------------------------------------------------
# 3. OBJECT STORAGE FOTO (Cloudinary — Sisi Klien)
# Digunakan untuk preview cepat & optimasi URL gambar publik
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"

# ------------------------------------------------------------------------------
# 4. ANTI-BOT / CAPTCHA (Cloudflare Turnstile Free — Sisi Klien)
# Gunakan Dummy Site Key Cloudflare `1x00000000000000000000AA` untuk testing lokal (selalu lolos)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
